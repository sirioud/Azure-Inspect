# Copy this file to .env and fill in your service-principal credentials.
# NEVER commit the real .env file.

AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-with-your-client-secret
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# --- Dashboard auth gate (optional) ---
# Set DASHBOARD_PASSWORD to require a password before the web UI is shown.
# Leave blank/unset for an open dashboard.
DASHBOARD_PASSWORD=
# Random secret used to sign the session cookie. Generate e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# If unset, a temporary key is used and logins expire on every restart.
DASHBOARD_SECRET=
# Set to 1 when serving over HTTPS to mark the session cookie Secure. Use 0 on plain HTTP / LAN.
DASHBOARD_SECURE_COOKIE=0
